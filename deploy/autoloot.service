[Unit]
Description=Autoloot single-streamer service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=autoloot
Group=autoloot
WorkingDirectory=/opt/autoloot
Environment=NODE_ENV=production
EnvironmentFile=/etc/autoloot.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/autoloot

[Install]
WantedBy=multi-user.target
