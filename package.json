{
  "name": "autoloot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo:check": "node scripts/demo-check.mjs",
    "docs:dev": "npm --prefix documentation run dev",
    "docs:build": "npm --prefix documentation run build",
    "docs:check": "npm --prefix documentation run docs:check && npm --prefix documentation run check:docs-tree",
    "storage:check": "node --env-file-if-exists=.env scripts/storage.mjs check",
    "storage:backup": "node --env-file-if-exists=.env scripts/storage.mjs backup",
    "storage:restore": "node --env-file-if-exists=.env scripts/storage.mjs restore",
    "start:production": "NODE_ENV=production node --env-file-if-exists=.env server.mjs",
    "production:check": "NODE_ENV=production node --env-file-if-exists=.env scripts/production-check.mjs",
    "marketing:build": "node marketing/build.mjs",
    "build:wallet": "node scripts/build-wallet.mjs",
    "prestart": "npm run build:wallet",
    "predev": "npm run build:wallet",
    "precheck": "npm run build:wallet"
  },
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.6.0",
    "@walletconnect/universal-provider": "^2.26.0",
    "qrcode": "^1.5.4",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "eslint-scope": "^9.1.2"
  }
}
