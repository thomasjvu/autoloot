{
  "name": "autoloot",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check/app.mjs",
    "demo:check": "node scripts/check/demo.mjs",
    "docs:dev": "node scripts/build/docs.mjs user dev",
    "docs:build": "node scripts/build/docs.mjs user build",
    "docs:check": "node scripts/build/docs.mjs user check",
    "storage:check": "node --env-file-if-exists=.env scripts/maintenance/storage.mjs check",
    "storage:backup": "node --env-file-if-exists=.env scripts/maintenance/storage.mjs backup",
    "storage:restore": "node --env-file-if-exists=.env scripts/maintenance/storage.mjs restore",
    "start:production": "NODE_ENV=production node --env-file-if-exists=.env server.mjs",
    "production:check": "NODE_ENV=production node --env-file-if-exists=.env scripts/check/production.mjs",
    "marketing:build": "node apps/marketing/build.mjs",
    "build:wallet": "node scripts/build/wallet.mjs",
    "prestart": "npm run build:wallet",
    "predev": "npm run build:wallet",
    "precheck": "npm run build:wallet",
    "worker:dev": "wrangler dev",
    "worker:build": "wrangler deploy --dry-run --outdir .worker-build",
    "worker:check": "npm run worker:build && node scripts/check/cloudflare.mjs",
    "worker:migrate:local": "wrangler d1 migrations apply DB --local",
    "worker:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "worker:deploy": "wrangler deploy",
    "companion:connect": "node scripts/runtime/companion-bridge.mjs",
    "worker:secrets": "node scripts/deploy/worker-secrets.mjs",
    "dev-docs:dev": "node scripts/build/docs.mjs dev dev",
    "dev-docs:build": "node scripts/build/docs.mjs dev build",
    "dev-docs:check": "node scripts/build/docs.mjs dev check",
    "worker:production:check": "node scripts/deploy/worker-production.mjs",
    "worker:production:build": "npm run build:wallet && node scripts/deploy/worker-production.mjs build",
    "worker:production:migrate": "node scripts/deploy/worker-production.mjs migrate",
    "worker:production:deploy": "npm run build:wallet && node scripts/deploy/worker-production.mjs deploy",
    "marketing:dev": "node apps/marketing/dev.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.6.0",
    "@walletconnect/universal-provider": "^2.26.0",
    "hono": "^4.13.16",
    "qrcode": "^1.5.4",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "eslint-scope": "^9.1.2",
    "miniflare": "^5.20261023.3-beta",
    "wrangler": "^4.156.0"
  }
}
