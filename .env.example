# Use production for a live service. Local development defaults remain available without this file.
NODE_ENV=production
DATA_DIR=.data
PORT=4173
# Register http://localhost:4173/auth/twitch/callback in the Twitch developer console.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
PUBLIC_URL=http://localhost:4173
# Optional: codex exec uses the local CLI's existing login (codex login).
# API-key alternative: start the server with CODEX_API_KEY set in your environment.
CODEX_BIN=codex
# Stripe Checkout: use a restricted key from your Stripe sandbox first.
# Secrets remain on this machine. Never commit .env.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated ISO country codes; edit to match your actual shipping region.
SHIPPING_COUNTRIES=US

# Hosted Metadata TCG data; kept on server, never sent to browser or Codex
METADATA_API_URL=https://metadata.fyi
METADATA_SERVICE_KEY=

# SQLite uses DATA_DIR (default .data); one active server per data directory.
# Online verified local backups also run at startup. Add encrypted off-site backups separately.
AUTOLOOT_BACKUP_MINUTES=60
AUTOLOOT_BACKUP_KEEP=24
# NFT verifier RPC endpoints, server-side only; use trusted services for the correct network.
# NFT_RPC_CONFIG={"eip155:8453":"https://your-base-rpc","solana:mainnet":"https://your-solana-rpc"}
NFT_RPC_CONFIG={}
# Optional constrained agent-wallet bridge (Autoloot adapter protocol; not a provider API).
NFT_WALLET_URL=
NFT_WALLET_TOKEN=
# Optional distinct agent token: can read authorized NFT jobs and submit transaction IDs only.
NFT_AGENT_TOKEN=

# Optional seller Shippo API token; use shippo_test_ first. Also configurable locally in Settings.
SHIPPO_API_TOKEN=
